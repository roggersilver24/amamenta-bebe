rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function member(fid) { return signed() && exists(/databases/$(database)/documents/families/$(fid)) && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)); }
    function admin(fid) { return member(fid) && get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.role == 'ADMIN'; }
    function owner(fid) { return signed() && get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid; }
    function bootstrapAdmin(fid) { return signed() && !exists(/databases/$(database)/documents/families/$(fid))
      && getAfter(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid
      && getAfter(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.role == 'ADMIN'; }
    function invitedEmail(data) { return signed() && request.auth.token.email_verified == true && request.auth.token.email == data.targetEmail; }
    function memberShape(data) { return data.keys().hasAll(['role','name','invitationId']) && data.keys().hasOnly(['role','name','invitationId'])
      && data.role in ['ADMIN','CAREGIVER'] && data.name is string && data.name.size() > 0 && data.name.size() <= 100
      && data.invitationId is string && data.invitationId.size() <= 64; }
    function invitationShape(data) { return data.keys().hasAll(['familyId','createdBy','targetEmail','expiresAt','consumedBy'])
      && data.keys().hasOnly(['familyId','createdBy','targetEmail','expiresAt','consumedBy'])
      && data.familyId is string && data.familyId.size() > 0 && data.familyId.size() <= 128
      && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
      && data.consumedBy is string && data.consumedBy.size() <= 128
      && data.targetEmail is string && data.targetEmail.size() > 0 && data.targetEmail.size() <= 254
      && data.targetEmail == data.targetEmail.lower() && data.expiresAt is timestamp; }
    // Validate every scalar so an authorized client cannot poison another phone's parser.
    function validTime(value) { return value is int && value > 0 && value <= 9000000000000000; }
    function feedingPayload(p) { return p is map
      && p.keys().hasAll(['timeMillis','type','side','amountMl','note','leftDurationMillis','rightDurationMillis'])
      && p.keys().hasOnly(['timeMillis','type','side','amountMl','note','leftDurationMillis','rightDurationMillis'])
      && validTime(p.timeMillis) && p.type in ['QUICK','BREAST','BOTTLE'] && p.side in ['NONE','LEFT','RIGHT','BOTH']
      && (p.amountMl == null || (p.amountMl is int && p.amountMl >= 0 && p.amountMl <= 9999))
      && p.note is string && p.note.size() <= 5000
      && p.leftDurationMillis is int && p.leftDurationMillis >= 0 && p.leftDurationMillis <= 9000000000000000
      && p.rightDurationMillis is int && p.rightDurationMillis >= 0 && p.rightDurationMillis <= 9000000000000000; }
    function diaperPayload(p) { return p is map && p.keys().hasAll(['timeMillis','type']) && p.keys().hasOnly(['timeMillis','type'])
      && validTime(p.timeMillis) && p.type in ['WET','DIRTY','BOTH']; }
    match /families/{fid} {
      allow read: if member(fid);
      allow create: if signed() && request.auth.uid.size() <= 128 && request.resource.data.keys().hasAll(['ownerUid','name','createdAt']) && request.resource.data.keys().hasOnly(['ownerUid','name','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.role == 'ADMIN';
      allow update, delete: if false;
      match /members/{uid} {
        allow read: if member(fid);
        allow create: if signed() && uid.size() <= 128 && uid == request.auth.uid && memberShape(request.resource.data) && (
          (request.resource.data.role == 'ADMIN' && request.resource.data.invitationId == ''
            && !exists(/databases/$(database)/documents/families/$(fid))
            && getAfter(/databases/$(database)/documents/families/$(fid)).data.ownerUid == uid)
          || (request.resource.data.role == 'CAREGIVER'
            && exists(/databases/$(database)/documents/families/$(fid))
            && request.resource.data.invitationId.matches('[0-9a-f]{64}')
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.familyId == fid
            && invitedEmail(get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data)
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.expiresAt > request.time
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.consumedBy == ''
            && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.consumedBy == uid));
        allow update: if false;
        allow delete: if admin(fid) && resource.data.role != 'ADMIN';
      }
      match /babies/{bid} {
        allow read: if member(fid);
        allow create: if (admin(fid) || bootstrapAdmin(fid)) && request.resource.data.keys().hasAll(['name','createdAt']) && request.resource.data.keys().hasOnly(['name','createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
        match /records/{rid} {
          function validRecord() { return request.resource.data.keys().hasAll(['kind','payload','authorUid','authorName','modifiedUid','revision','deleted','updatedAt']) && request.resource.data.keys().hasOnly(['kind','payload','authorUid','authorName','modifiedUid','revision','deleted','updatedAt'])
            && ((request.resource.data.kind == 'FEEDING' && feedingPayload(request.resource.data.payload)) || (request.resource.data.kind == 'DIAPER' && diaperPayload(request.resource.data.payload)))
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() <= 100 && request.resource.data.authorUid is string
            && request.resource.data.authorUid.size() > 0 && request.resource.data.authorUid.size() <= 128
            && request.resource.data.modifiedUid == request.auth.uid && request.resource.data.modifiedUid.size() <= 128 && request.resource.data.revision is int
            && request.resource.data.revision > 0 && request.resource.data.revision <= 9000000000000000
            && request.resource.data.deleted is bool && request.resource.data.updatedAt == request.time; }
          allow read: if member(fid) && exists(/databases/$(database)/documents/families/$(fid)/babies/$(bid));
          allow create: if member(fid) && exists(/databases/$(database)/documents/families/$(fid)/babies/$(bid))
            && validRecord() && request.resource.data.authorUid == request.auth.uid && request.resource.data.revision == 1;
          allow update: if member(fid) && exists(/databases/$(database)/documents/families/$(fid)/babies/$(bid)) && validRecord() && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.authorName == resource.data.authorName && request.resource.data.kind == resource.data.kind
            && request.resource.data.revision == resource.data.revision + 1;
          allow delete: if false;
        }
      }
    }
    match /invitations/{iid} {
      allow get: if admin(resource.data.familyId) || invitedEmail(resource.data);
      allow list: if admin(resource.data.familyId);
      allow create: if admin(request.resource.data.familyId) && iid.matches('[0-9a-f]{64}')
        && invitationShape(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.targetEmail is string
        && request.resource.data.targetEmail.size() <= 254 && request.resource.data.targetEmail == request.resource.data.targetEmail.lower()
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') && request.resource.data.consumedBy == '';
      allow update: if invitationShape(request.resource.data) && invitedEmail(resource.data) && exists(/databases/$(database)/documents/families/$(resource.data.familyId)) && resource.data.expiresAt > request.time && resource.data.consumedBy == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumedBy'])
        && request.resource.data.consumedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.role == 'CAREGIVER'
        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.invitationId == iid;
      allow delete: if admin(resource.data.familyId);
    }
  }
}
